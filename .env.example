# GEMINI_API_KEY: Required for server-side Gemini AI PDF academic calendar extraction & source parsing.
# Kept strictly on the server (never exposed to browser code).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Stage 2+ Persistence & Private PDF Storage Bucket)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# N8N SCHEDULED INGESTION & WEBHOOK SECRET (Stage 6 Automation)
N8N_INGESTION_WEBHOOK_SECRET="your-n8n-webhook-hmac-secret"

